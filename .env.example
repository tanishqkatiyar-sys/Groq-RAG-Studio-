# Groq RAG Studio — Environment Configuration
# Copy this file to .env and fill in your values

# =====================================================
# REQUIRED
# =====================================================
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=

# =====================================================
# OPTIONAL — Model Selection (defaults shown)
# =====================================================
# Available: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it, openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Embedding model (local, CPU-only)
# See: https://huggingface.co/sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2